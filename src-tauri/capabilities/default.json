  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "capabilities for the main widget window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:menu:default",
